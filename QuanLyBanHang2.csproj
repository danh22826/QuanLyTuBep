<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>QuanLyBanTuBep</RootNamespace>
    <AssemblyName>QuanLyBanHang2</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>x64</PlatformTarget>
    <CrystalSdkPath Condition="'$(CrystalSdkPath)' == ''">$(MSBuildProgramFiles32)\SAP BusinessObjects\Crystal Reports for .NET Framework 4.0\Common\SAP BusinessObjects Enterprise XI 4.0\win64_x64\dotnet</CrystalSdkPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Images\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Reports\*.rpt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="CrystalDecisions.CrystalReports.Engine" HintPath="$(CrystalSdkPath)\CrystalDecisions.CrystalReports.Engine.dll" />
    <Reference Include="CrystalDecisions.ReportSource" HintPath="$(CrystalSdkPath)\CrystalDecisions.ReportSource.dll" />
    <Reference Include="CrystalDecisions.Shared" HintPath="$(CrystalSdkPath)\CrystalDecisions.Shared.dll" />
    <Reference Include="CrystalDecisions.Windows.Forms" HintPath="$(CrystalSdkPath)\CrystalDecisions.Windows.Forms.dll" />
  </ItemGroup>

</Project>

